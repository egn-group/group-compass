{
  "name": "group-compass-api",
  "version": "1.0.0",
  "description": "Azure Functions API for Group Compass",
  "scripts": {
    "build": "prisma generate && tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "db:verify": "npm run build && node dist/api/scripts/verify-crud.js",
    "db:verify:users": "npm run build && node dist/api/scripts/verify-users-auth.js",
    "db:verify:groups": "npm run build && node dist/api/scripts/verify-groups-import.js",
    "verify:ai": "npm run build && node dist/api/scripts/verify-ai-call.js",
    "verify:dna": "npm run build && node dist/api/scripts/verify-dna-generation.js",
    "verify:launch": "npm run build && node dist/api/scripts/verify-launch.js",
    "verify:na-comments": "npm run build && node dist/api/scripts/verify-na-comments.js",
    "verify:score-dna-version": "npm run build && node dist/api/scripts/verify-score-dna-version.js",
    "verify:chair-review": "npm run build && node dist/api/scripts/verify-chair-review.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@azure/functions": "^3.5.1",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
