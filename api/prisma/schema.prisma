// Core entities per spec §12 ("Import, export, and data model").
// See /CONTEXT.md for the terms this schema sharpens beyond the spec's
// own wording, and the wayfinder map (GitHub issue #1) decision log for
// the reasoning behind each — including DnaVersion.changeList, the one
// spec-listed attribute deliberately left out (see that model below).

generator client {
  provider = "prisma-client-js"
  // Generated OUTSIDE node_modules deliberately: Azure Static Web Apps'
  // Oryx build service caches/copies an isolated production-only
  // node_modules install back over api/node_modules AFTER this build's own
  // `prisma generate && tsc` step already ran — silently clobbering
  // whatever `prisma generate` had just written to the default
  // node_modules/.prisma/client location, even though the build itself
  // reports success. This is the documented fix for the resulting
  // "@prisma/client did not initialize yet" runtime error on Azure Static
  // Web Apps + Prisma (microsoft/Oryx#1696) — api/shared/prismaClient.ts
  // is the only place that imports from this location directly.
  output = "../generated/prisma-client"
  // "native" alone only covers whatever platform ran `prisma generate`
  // (Oryx's own build container) — kept alongside explicit Linux targets
  // since that's not guaranteed to match the actual Functions runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  Admin
  Chair
  NetworkAdvisor
  ChairLeader
  SalesLeader
}

enum GroupLifecycleStatus {
  Imported
  DraftGenerated
  Launched
  ChairReview
  Approved
  Closed
}

enum DnaField {
  GroupProfile
  MemberProfile
  CompaniesProfile
}

enum DnaVersionAuthor {
  Ai
  Chair
  Admin
  NetworkAdvisor
}

enum DnaVersionScoreStage {
  Imported
  AutoGenerated
  ChairEdited
}

enum CommentAuthorRole {
  NetworkAdvisor
  SalesLeader
}

enum EventType {
  Import
  Generate
  Launch
  Reassign
  Comment
  Edit
  Approve
  Export
  Reset
}

enum ConversationRole {
  Chair
  Ai
}

enum ConversationOutcome {
  Accepted
  Rejected
  None
}

model User {
  email     String   @id
  name      String
  initials  String
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Network Advisor first-time guidance banner (spec §5's three prompts) —
  // shown once per NA, not repeated every visit. Keyed to the real logged-in
  // user, unlike the prototype's per-browser localStorage stand-in.
  hasSeenNaGuidance Boolean @default(false)

  chairOfGroups          Group[]              @relation("GroupChair")
  networkAdvisorOfGroups Group[]              @relation("GroupNetworkAdvisor")
  events                 Event[]
  aiConversationTurns    AiConversationTurn[]
}

model Group {
  id                String               @id @default(cuid())
  // Deliberately not unique: spec §12 ("the same EGN Group ID may
  // therefore exist as more than one record when required, for example
  // to compare alternative versions").
  egnGroupId        String
  mmsGroupCode      String?
  partnerCode       String
  country           String
  name              String
  lifecycleStatus   GroupLifecycleStatus @default(Imported)
  pendingReapproval Boolean              @default(false)
  noSourceDna       Boolean              @default(false)
  // The live imported text (spec §12's group export columns), compared
  // against on re-import. Distinct from DnaVersion.content (a full
  // versioned snapshot) and DnaField (which of these three a per-field
  // Comment/AiConversationTurn refers to).
  groupProfile      String
  memberProfile     String
  companiesProfile  String
  // Snapshot of the same fields Edit can change (name/mmsGroupCode/
  // partnerCode/the 3 profile texts — country is derived, chair/NA go
  // through Reassign), written by putGroups on every create AND
  // overwrite/re-import. Lets an Admin discard edits and go back to
  // whatever the last import actually said, without a full CSV re-import.
  // Null for a group that predates this field (nothing to reset to until
  // it's re-imported). Not a DnaVersion: this covers the metadata fields
  // DnaVersion doesn't, and DnaVersion's own Imported-stage version is
  // both optional (only created once Generate first runs) and never
  // updated by a later re-import.
  importedSnapshot  Json?
  // Single-level "Undo last change" per field (prototype parity, HANDOFF.md
  // §1 "chair-groups-live.html's ... previousText"). A partial map of
  // DnaField -> the field's text immediately before its most recent change
  // (saveChairFieldEdit overwrites the entry for whichever field just
  // changed); undoChairField consumes and clears the entry for that field,
  // so a second Undo click has nothing left to revert to until another real
  // edit happens — same "one level, then gone" semantics as the prototype.
  pendingUndo       Json?
  // Optional grounding context for DNA generation (spec §8) — titles +
  // companies of existing members, no names — pasted on the group detail
  // page or "Add one group manually" and kept here so it survives a
  // refresh/later visit instead of being lost the moment the page changes,
  // per user feedback ("keep the group roster on the group detail page if
  // it is added"). Deliberately its own field, not part of importedSnapshot
  // or a DnaVersion: it isn't part of the group's own DNA content, and
  // Reset must not discard it along with the profile texts.
  roster            String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  // Which of the 3 fields the Chair has individually approved during
  // review (issue #25). Never cleared by a later edit — once a field is
  // approved, editing its text again doesn't un-approve it; only
  // `pendingReapproval` (set when editing an already-Approved group)
  // signals that a fresh look is warranted.
  approvedFields    DnaField[]           @default([])

  chairEmail          String?
  chair               User?   @relation("GroupChair", fields: [chairEmail], references: [email])
  networkAdvisorEmail String?
  networkAdvisor      User?   @relation("GroupNetworkAdvisor", fields: [networkAdvisorEmail], references: [email])

  dnaVersions         DnaVersion[]
  comments            Comment[]
  events              Event[]
  aiConversationTurns AiConversationTurn[]

  @@index([egnGroupId])
}

// Note: spec §12 also lists a "change list (for AI versions)" attribute
// here, for the on-demand AI change-list ("Auditor") feature. That
// feature was dropped from the real build (wayfinder map, issue #1,
// "Out of scope") before this schema was drafted, so it's omitted here
// rather than built around.
model DnaVersion {
  id            String                @id @default(cuid())
  groupId       String
  group         Group                 @relation(fields: [groupId], references: [id])
  versionNumber Int
  content       Json
  // Spec §12 says "author (AI/Chair/Admin)" — three values — but spec
  // §10 lists an NA comment round among the things that "creates a new
  // version with timestamp and author". NetworkAdvisor is added so that
  // case has a real author instead of falling outside the enum.
  // Nullable: the Imported-stage version (the group's original text, as
  // CSV-imported) has no real author in this sense — nobody wrote or
  // edited it, it's just what came in — so recording one (e.g. "Admin",
  // who merely ran the import) would misrepresent it.
  author        DnaVersionAuthor?
  score         Int?
  // Spec §9: "The score is stored at three stages: the original imported
  // DNA, the auto-generated DNA, and each Chair-edited saved version."
  scoreStage    DnaVersionScoreStage?
  createdAt     DateTime              @default(now())

  comments Comment[]

  @@unique([groupId, versionNumber])
}

model Comment {
  id           String            @id @default(cuid())
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id])
  dnaVersionId String
  dnaVersion   DnaVersion        @relation(fields: [dnaVersionId], references: [id])
  field        DnaField
  author       CommentAuthorRole
  text         String
  createdAt    DateTime          @default(now())
  // Set once the Chair has addressed this comment — via "Read & accept"
  // (approving the field as-is) or a manual edit to that field (issue #25).
  // A comment does get deleted in two cases: putNaComments replaces (not
  // appends) any existing NA comment for the same field when a new round's
  // comment comes in, and resetGroup clears all of a group's NA comments —
  // both keep "at most one NA comment per field, at any time" true. Neither
  // touches `resolved` directly, which is why it still exists as its own
  // flag rather than being folded into deletion.
  resolved     Boolean           @default(false)
}

model Event {
  id         String    @id @default(cuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id])
  type       EventType
  actorEmail String
  actor      User      @relation(fields: [actorEmail], references: [email])
  timestamp  DateTime  @default(now())
}

model AiConversationTurn {
  id           String              @id @default(cuid())
  groupId      String
  group        Group               @relation(fields: [groupId], references: [id])
  field        DnaField
  chairEmail   String
  chair        User                @relation(fields: [chairEmail], references: [email])
  role         ConversationRole
  messageText  String?
  proposedText String?
  outcome      ConversationOutcome
  createdAt    DateTime            @default(now())
}
