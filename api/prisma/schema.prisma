// Core entities per spec §12 ("Import, export, and data model").
// See /CONTEXT.md for the terms this schema had to sharpen beyond the
// spec's own wording (lifecycle status values, version numbering,
// DnaVersion.author, DnaField, Event.type) and for the one spec-listed
// attribute deliberately left out (DnaVersion.changeList).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  Admin
  Chair
  NetworkAdvisor
  ChairLeader
  SalesLeader
}

enum GroupLifecycleStatus {
  Imported
  DraftGenerated
  Launched
  ChairReview
  Approved
  Closed
}

enum DnaField {
  GroupProfile
  MemberProfile
  CompaniesProfile
}

enum DnaVersionAuthor {
  Ai
  Chair
  Admin
  NetworkAdvisor
}

enum DnaVersionScoreStage {
  Imported
  AutoGenerated
  ChairEdited
}

enum CommentAuthorRole {
  NetworkAdvisor
  SalesLeader
}

enum EventType {
  Import
  Generate
  Launch
  Reassign
  Comment
  Edit
  Approve
  Export
}

enum ConversationRole {
  Chair
  Ai
}

enum ConversationOutcome {
  Accepted
  Rejected
  None
}

model User {
  email     String   @id
  name      String
  initials  String
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chairOfGroups          Group[]              @relation("GroupChair")
  networkAdvisorOfGroups Group[]              @relation("GroupNetworkAdvisor")
  events                 Event[]
  aiConversationTurns    AiConversationTurn[]
}

model Group {
  id                String               @id @default(cuid())
  egnGroupId        String
  mmsGroupCode      String?
  partnerCode       String
  country           String
  name              String
  lifecycleStatus   GroupLifecycleStatus @default(Imported)
  pendingReapproval Boolean              @default(false)
  noSourceDna       Boolean              @default(false)
  groupProfile      String
  memberProfile     String
  companiesProfile  String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  chairEmail          String?
  chair               User?   @relation("GroupChair", fields: [chairEmail], references: [email])
  networkAdvisorEmail String?
  networkAdvisor      User?   @relation("GroupNetworkAdvisor", fields: [networkAdvisorEmail], references: [email])

  dnaVersions         DnaVersion[]
  comments            Comment[]
  events              Event[]
  aiConversationTurns AiConversationTurn[]

  @@index([egnGroupId])
}

model DnaVersion {
  id            String                @id @default(cuid())
  groupId       String
  group         Group                 @relation(fields: [groupId], references: [id])
  versionNumber Int
  content       Json
  author        DnaVersionAuthor
  score         Int?
  scoreStage    DnaVersionScoreStage?
  createdAt     DateTime              @default(now())

  comments Comment[]

  @@unique([groupId, versionNumber])
}

model Comment {
  id           String            @id @default(cuid())
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id])
  dnaVersionId String
  dnaVersion   DnaVersion        @relation(fields: [dnaVersionId], references: [id])
  field        DnaField
  author       CommentAuthorRole
  text         String
  createdAt    DateTime          @default(now())
}

model Event {
  id         String    @id @default(cuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id])
  type       EventType
  actorEmail String
  actor      User      @relation(fields: [actorEmail], references: [email])
  timestamp  DateTime  @default(now())
}

model AiConversationTurn {
  id           String              @id @default(cuid())
  groupId      String
  group        Group               @relation(fields: [groupId], references: [id])
  field        DnaField
  chairEmail   String
  chair        User                @relation(fields: [chairEmail], references: [email])
  role         ConversationRole
  messageText  String?
  proposedText String?
  outcome      ConversationOutcome
  createdAt    DateTime            @default(now())
}
