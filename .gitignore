# Secrets
.env
!.env.example

# Ephemeral scratch space (wizards, throwaway scripts, one-off notes) —
# never committed, may contain captured credentials.
.scratch/

# Dependencies
node_modules/

# App build output
dist/
api/dist/
node_modules/.tmp/
# Prisma's generated client — deliberately output outside node_modules
# (see api/prisma/schema.prisma's generator block); still build output,
# not source, so gitignored the same as api/dist/.
api/generated/
api/local.settings.json
.swa/
# shared/ holds only source .ts — each consumer (api/, the React app)
# compiles it into its own dist, never in place.
shared/**/*.js
shared/**/*.js.map

# OS/Windows artifacts
*:Zone.Identifier
.DS_Store

# Personal Claude Code settings (machine-specific)
.claude/settings.local.json
.claude/.cc-writes/

# Sandbox environment artifacts (not real project files)
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc
.claude/agents
.claude/commands
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/scheduled_tasks.json
.claude/settings.json
.claude/workflows
