# Copy this file to .env and fill in your own key.
# Never commit the real .env file — .gitignore already excludes it.

ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Optional overrides:
# PORT=3000
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: use a cheaper/faster model for the mechanical "Notary" stage
# only (stage 1 of the pipeline). Leave unset to use ANTHROPIC_MODEL for
# every stage, unchanged from today. Re-run the calibration set before
# trusting a different model here.
# ANTHROPIC_NOTARY_MODEL=claude-haiku-4-5-20251001
